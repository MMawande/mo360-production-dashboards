{
  "name": "proddshbrd-etl-job-v1",
  "email_notifications": {
    "no_alert_for_skipped_runs": false,
    "on_failure": [
      "dw_050-itocs_mo360dp-con-proddashboards@mercedes-benz.com"
    ]
