        "policy_name": "mo360dp-proddshbrd-single-user-job-compute",
        "apply_policy_default_values": true,
        "custom_tags": {
          "jobOwner": "proddshbrd",
          "jobPurpose": "proddshbrd-ETL"
        },
        "cluster_log_conf": {
          "dbfs": {
            "destination": "dbfs:/cluster_logs"
          }
        },
        "enable_elastic_disk": false
      }
    }
  ],
